{
  "name": "dsh-coding-enhanced",
  "version": "0.6.2",
  "description": "The DSH change gate: queue AI edits before write, rewind turns with shadow-git snapshots, and hand review to a non-blocking waiter subagent.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "change-gate",
    "human-in-the-loop",
    "code-review",
    "withdraw",
    "checkpoint",
    "non-blocking",
    "passkey",
    "cross-review"
  ],
  "license": "MIT",
  "author": "dsh-coding-enhanced contributors",
  "scripts": {
    "pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-2021/dsh-coding-enhanced.git"
  },
  "homepage": "https://github.com/hello-2021/dsh-coding-enhanced#readme",
  "bugs": {
    "url": "https://github.com/hello-2021/dsh-coding-enhanced/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
