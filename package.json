{
  "name": "dsh-coding-enhanced",
  "version": "0.5.22",
  "description": "DSH bundle: AI change review with a right-sidebar diff gate, and multi-turn workspace withdraw.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "review",
    "patch",
    "undo",
    "withdraw"
  ],
  "license": "MIT",
  "author": "dsh-coding-enhanced contributors",
  "scripts": {
    "pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-2021/dsh-coding-enhanced.git"
  },
  "homepage": "https://github.com/hello-2021/dsh-coding-enhanced#readme",
  "bugs": {
    "url": "https://github.com/hello-2021/dsh-coding-enhanced/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
